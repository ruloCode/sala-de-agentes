# ── Voz (ElevenLabs) ───────────────────────────────────────────────────
# La key NO sale del servidor: el agente emite credenciales efímeras por
# personaje en GET /sala/token. Sin ella, las pantallas lo dicen y no hablan.
ELEVENLABS_API_KEY=

# ── Agente ─────────────────────────────────────────────────────────────
PORT=8650
# Vacío = el agente solo acepta localhost. Con clave escucha en la red local
# (para servir una pantalla desde otro equipo) y exige Bearer.
SALA_API_KEY=
MACHINE_NAME=local
# "off" apaga /sala/* o /metro/* por completo.
SALA_ENABLED=
ESTACION_ENABLED=
# Carpeta de configuración fuera del repo (default: ~/.sala, y si no existe
# pero sí ~/.hermes-os, se usa esa).
SALA_HOME=
# Zona horaria del sistema de transporte, para "próximo tren".
SALA_METRO_TZ=America/Bogota

# ── Web ────────────────────────────────────────────────────────────────
SALA_WEB_PORT=31999
NEXT_PUBLIC_SALA_AGENT_URL=http://localhost:8650
NEXT_PUBLIC_SALA_API_KEY=
# Nombre con el que la sala se dirige a quien la usa. Vacío = sin nombre.
NEXT_PUBLIC_SALA_OWNER_NAME=
# URL pública (https) de esta web: es la que va dentro del QR del tótem. Sin
# ella el QR usa la IP de la red local, y por http el celular ve la ruta pero
# no puede hablar (el navegador exige contexto seguro para el micrófono).
NEXT_PUBLIC_ESTACION_PUBLIC_URL=
