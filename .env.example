# ── Voz (ElevenLabs) ───────────────────────────────────────────────────
# La key NO sale del servidor: el agente emite credenciales efímeras por
# personaje en GET /sala/token. Sin ella, las pantallas lo dicen y no hablan.
ELEVENLABS_API_KEY=

# ── Direcciones (Google Maps Geocoding) ────────────────────────────────
# Solo para DIRECCIONES ("calle 10 con la 43"): el agente manda el texto de la
# dirección a Google y recibe la coordenada; la key no sale del servidor.
# Barrios (~/.sala/barrios.json) y estaciones (GTFS) nunca pasan por aquí.
# Vacía = las direcciones no se resuelven y el tótem lo dice.
GOOGLE_MAPS_API_KEY=

# ── Agente ─────────────────────────────────────────────────────────────
PORT=8650
# Vacío = el agente solo acepta localhost. Con clave escucha en la red local
# (para servir una pantalla desde otro equipo) y exige Bearer.
SALA_API_KEY=
MACHINE_NAME=local
# "off" apaga /sala/* o /metro/* por completo.
SALA_ENABLED=
ESTACION_ENABLED=
# Carpeta de configuración fuera del repo (default: ~/.sala, y si no existe
# pero sí ~/.hermes-os, se usa esa).
SALA_HOME=
# Zona horaria del sistema de transporte, para "próximo tren".
SALA_METRO_TZ=America/Bogota
# Origins públicos que además de la red privada pueden llamar al agente,
# separados por coma. En producción la web va por su propio proxy y esto
# queda vacío.
SALA_ALLOWED_ORIGINS=

# Rutas sueltas dentro de SALA_HOME. Solo hacen falta si la config no está
# toda junta (p. ej. un volumen montado archivo por archivo).
# SALA_CONFIG_PATH=
# SALA_GTFS_DIR=
# SALA_METRO_CONFIG=
# SALA_METRO_STATUS_PATH=
# SALA_PLACES_PATH=
# SALA_OWNER_NAME=

# ── Web ────────────────────────────────────────────────────────────────
SALA_WEB_PORT=31999
# Nombre con el que la sala se dirige a quien la usa. Vacío = sin nombre.
NEXT_PUBLIC_SALA_OWNER_NAME=

# MODO DIRECTO (desarrollo y LAN): la pantalla llama al agente de frente.
# Déjalo vacío en producción: sin esto la web usa su propio proxy
# /api/agent/* y la clave se queda en el servidor.
NEXT_PUBLIC_SALA_AGENT_URL=http://localhost:8650
# OJO: una variable NEXT_PUBLIC viaja dentro del bundle. Esta clave solo se
# pone cuando el agente está en una red privada y se asume público leerla.
NEXT_PUBLIC_SALA_API_KEY=

# ── Producción (Vercel) ────────────────────────────────────────────────
# Estas dos son de SERVIDOR: no llevan NEXT_PUBLIC y no entran al bundle.
# El route handler /api/agent/* las usa para hablar con el agente.
# SALA_AGENT_URL=https://agente.tudominio.com
# SALA_API_KEY=<la misma clave que corre en el agente>
#
# URL pública (https) de esta web: es la que va dentro del QR del tótem. Sin
# ella el QR cae al origen desde el que se abrió la pantalla, y si eso es una
# IP de la LAN el celular ve la ruta pero no puede hablar (el navegador exige
# contexto seguro para el micrófono).
# NEXT_PUBLIC_ESTACION_PUBLIC_URL=https://sala.tudominio.com
